                <mxCell id="glhanbb3aN2LTGsA86wO-9" value="1.- deployInvariantsContract - (OnlyDeployers) - (OK)&#xa;2.- transferOwnership (ZamnaFactory) - (onlyOwner) - (OK)&#xa;3.- Change_Configurer_Role - (onlyConfigurer) - (OK)&#xa;4.- Change_Asker_Role - (onlyConfigurer) - (OK)&#xa;5.- SetFeeTokens - (onlyOwner) - (OK)&#xa;6.- SetFeeAmount - (onlyOwner) - (OK)" style="text;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="glhanbb3aN2LTGsA86wO-1" vertex="1">
